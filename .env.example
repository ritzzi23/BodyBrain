# Copy to .env. Keep this file free of real credentials.
# The API binds to 127.0.0.1:8080; the UI proxies /api locally.
BODYBRAIN_DATA_DIR=.bodybrain
BODYBRAIN_API_TOKEN=
# Optional local API origin for the Vite development/preview proxy.
# BODYBRAIN_API_URL=http://127.0.0.1:8080

# Cognee: disabled, rest (hosted/self-hosted), or sdk (optional local Python SDK).
# COGNEE_API_KEY is issued by Cognee Cloud, not by a model provider.
# Copy COGNEE_URL from the Cloud dashboard's API Keys page, e.g.
# https://your-tenant.aws.cognee.ai (replace the placeholder with your actual host).
# Never set both COGNEE_API_KEY and COGNEE_BEARER_TOKEN.
COGNEE_MODE=disabled
COGNEE_URL=
COGNEE_API_KEY=
COGNEE_BEARER_TOKEN=
COGNEE_DATASET=bodybrain

# ClawMax dashboard + imported workflow IDs from integrations/clawmax.
# CLAWMAX_TOKEN authenticates to the dashboard API. It is not the agent's LLM key.
# Hosted v1.9.10-test-cognee2 requires an operator-issued dashboard credential.
# Configure the agent's model key in its ClawMax workspace after the invitation.
CLAWMAX_URL=
CLAWMAX_TOKEN=
CLAWMAX_INGEST_WORKFLOW_ID=bodybrain-ingestion
CLAWMAX_EVIDENCE_WORKFLOW_ID=bodybrain-evidence
# Automatic hosted-agent alternative: separate, unindexed Cognee inbox/outbox.
# Requires a running worker from integrations/clawmax/relay; no dashboard token
# or public callback is required in cognee_relay mode. Default keeps direct API.
CLAWMAX_TRANSPORT=dashboard
CLAWMAX_RELAY_INBOX=bodybrain_clawmax_jobs
CLAWMAX_RELAY_OUTBOX=bodybrain_clawmax_results

# Use the same random agent token in the backend and the ClawMax runtime.
# Do not put it into workflow prompts or Run Instructions.
# Hosted agents need actual runtime injection; browser-local keys do not suffice.
BODYBRAIN_AGENT_TOKEN=
# For hosted agents use a TLS tunnel to the callback-only proxy (port 8081).
# This URL belongs in the agent's environment, not backend Settings.
BODYBRAIN_BACKEND_URL=http://127.0.0.1:8080
# For a separately authorized hosted deployment, list its exact host/origin.
# Public hosts require a nonempty BODYBRAIN_API_TOKEN distinct from the agent token.
# BODYBRAIN_ALLOWED_HOSTS=localhost,127.0.0.1,bodybrain.example.com
# BODYBRAIN_ALLOWED_ORIGINS=https://bodybrain.example.com

# Optional local Cognee SDK: model-provider credentials, separate from both APIs above.
# Use a key authorized for Cognee model calls; keep actual values in ignored .env.
# Explicit OpenAI example (see integrations/cognee/README.md for installation):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# EMBEDDING_API_KEY is optional when the same authorized LLM_API_KEY serves both.
# EMBEDDING_API_KEY=
