{
  "name": "bodybrain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "datasets:prepare": "backend/.venv/bin/python scripts/prepare-datasets.py",
    "datasets:run": "backend/.venv/bin/python scripts/run-datasets.py",
    "preview": "vite preview --host 127.0.0.1 --port 3016",
    "dev:ui": "vite --host 127.0.0.1 --port 3016",
    "backend": "backend/.venv/bin/python -m uvicorn bodybrain.main:app --app-dir backend --host 127.0.0.1 --port 8080",
    "backend:worker-proxy": "backend/.venv/bin/python -m uvicorn bodybrain.worker_proxy:create_proxy --factory --app-dir backend --host 127.0.0.1 --port 8081 --env-file .env --no-access-log --no-proxy-headers",
    "test:backend": "node scripts/test-backend.mjs",
    "test:frontend": "node --experimental-strip-types --test src/backend-api.test.mjs src/backend-state.test.mjs src/chat-history.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
